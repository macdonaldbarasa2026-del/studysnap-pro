# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLIENT_ORIGIN: The origin allowed to connect via Socket.IO (CORS).
# Set this to your deployed frontend URL in production, e.g. https://studysnap.app
CLIENT_ORIGIN="http://localhost:5173"

# ADMIN_PASSWORD: Required to unlock the in-app Admin Console.
# Must be set to a strong, unique value in every deployment.
# If unset, the admin console is disabled server-side (safe default).
ADMIN_PASSWORD=""

# YouTube Data API v3 for live baby/kids learning video search
YOUTUBE_API_KEY=
YOUTUBE_REGION=KE
# Comma-separated channel IDs approved by the StudySnap owner for baby/kids content
YOUTUBE_ALLOWED_CHANNEL_IDS=

# Google Programmable Search Engine (client-side Standard Search Element)
# Create one at https://programmablesearchengine.google.com/
# No API secret is required for the standard search element.
VITE_GOOGLE_CSE_ID=
