rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /institution-verification/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType.matches('application/pdf|image/.*');
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
